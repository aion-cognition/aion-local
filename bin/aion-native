#!/usr/bin/env bash
# Compatibility name for existing PATH links. The recorded install profile owns dispatch.
set -eo pipefail
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  TARGET="$(readlink "$SELF")"
  case "$TARGET" in
    /*) SELF="$TARGET" ;;
    *) SELF="$(dirname -- "$SELF")/$TARGET" ;;
  esac
done
exec "$(dirname -- "$SELF")/aion" "$@"
