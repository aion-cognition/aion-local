#!/usr/bin/env bash
# Host wrapper for the native install profile: the same CLI, run on host Node against host
# processes, with no image and no container. `bin/aion` is the docker profile's wrapper and
# drives compose; this one only sources `.env` and executes.
#
# Sourcing the file is the point. Compose hands `.env` to the containers, so nothing in this
# build loads it on the host, and a CLI run that did not source it would resolve the compose
# service names instead of the loopback addresses a native install recorded.
set -eo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  TARGET="$(readlink "$SELF")"
  case "$TARGET" in
    /*) SELF="$TARGET" ;;
    *) SELF="$(dirname -- "$SELF")/$TARGET" ;;
  esac
done
REPO_DIR="$(cd -- "$(dirname -- "$SELF")/.." && pwd)"
CLI_MAIN="$REPO_DIR/packages/cli/dist/main.js"
MCP_MAIN="$REPO_DIR/packages/mcp/dist/main.js"

if [ ! -f "$CLI_MAIN" ]; then
  echo "aion: $CLI_MAIN is not built; run \`npm ci && npm run build\` in $REPO_DIR" >&2
  exit 1
fi

if [ -f "$REPO_DIR/.env" ]; then
  # `set -a` exports every assignment the file makes; an already-exported value still wins,
  # because the shell's own environment is applied over the file by the re-export below.
  PRESET="$(export -p)"
  set -a
  # shellcheck disable=SC1091
  . "$REPO_DIR/.env"
  set +a
  eval "$PRESET"
fi

AION_GIT_USER_NAME="${AION_GIT_USER_NAME:-$(git -C "$REPO_DIR" config user.name 2>/dev/null || true)}"
# HEAD travels two ways here as well: handed to every CLI run (AION_REPO_HEAD_SHA) and written
# into the launchd job's environment by init (AION_BUILD_SHA), which is what a native install has
# instead of a sha baked into an image. `doctor` compares the two, so a service left behind by an
# older checkout shows up as stale rather than as healthy.
AION_REPO_HEAD_SHA="$(git -C "$REPO_DIR" rev-parse --short HEAD 2>/dev/null || true)"
export AION_GIT_USER_NAME AION_REPO_HEAD_SHA
export AION_REPO_PATH="$REPO_DIR"

# Epoch seconds of the newest tracked source the build consumes. `git ls-files` rather than
# `find`, so node_modules and the build output never count; the test and fixture files the
# package tsconfigs exclude are left out too, since editing one changes nothing under dist.
newest_source_mtime() {
  git -C "$REPO_DIR" ls-files -z -- \
      'packages/*/src/*' 'package.json' 'package-lock.json' 'tsconfig*.json' \
      ':(exclude)*.test.ts' ':(exclude)*.fixture.*' 2>/dev/null |
    xargs -0 stat -f '%m' 2>/dev/null |
    sort -rn |
    head -1
}

# Whether the two built entry points are what HEAD says they are. `npm run build` is a separate
# step on this profile, where `bin/aion` rebuilds its image on the way past, so a pull with no
# build would stamp the job with a sha the running code does not hold and `doctor` would read a
# stale service as fresh. Unstamped is the honest answer there, and the freshness warning names
# the build. A machine whose `stat` cannot answer counts as not built, for the same reason.
build_holds_head() {
  local built source
  built="$(stat -f '%m' "$CLI_MAIN" "$MCP_MAIN" 2>/dev/null | sort -n | head -1)"
  [ -n "$built" ] || return 1
  source="$(newest_source_mtime)"
  [ -n "$source" ] || return 1
  [ "$source" -le "$built" ]
}

if build_holds_head; then
  AION_BUILD_SHA="$AION_REPO_HEAD_SHA"
  export AION_BUILD_SHA
fi

hooks_installed_in() {
  [ -f "$1" ] && grep -q 'hook-main.js' "$1"
}

if hooks_installed_in "$HOME/.claude/settings.json" ||
  hooks_installed_in "${CODEX_HOME:-$HOME/.codex}/hooks.json"; then
  AION_HOOKS_INSTALLED=true
else
  AION_HOOKS_INSTALLED=false
fi
export AION_HOOKS_INSTALLED

exec node "$CLI_MAIN" "$@"
