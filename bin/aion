#!/usr/bin/env bash
# Host wrapper. Keeps the image in step with the working tree, then runs the CLI in the
# aion-cli container, which is itself the orchestrator of the compose services.
set -eo pipefail

# The wrapper may be reached through a PATH symlink (`aion link` installs one), so the
# repo is found by resolving the symlink chain first; dirname of the symlink itself
# would point at the bin directory the link lives in, not at this repo.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  TARGET="$(readlink "$SELF")"
  case "$TARGET" in
    /*) SELF="$TARGET" ;;
    *) SELF="$(dirname -- "$SELF")/$TARGET" ;;
  esac
done
REPO_DIR="$(cd -- "$(dirname -- "$SELF")/.." && pwd)"
COMPOSE_FILE="$REPO_DIR/compose.yaml"
IMAGE="aion-local:latest"

COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-aion}"
AION_GIT_USER_NAME="${AION_GIT_USER_NAME:-$(git -C "$REPO_DIR" config user.name 2>/dev/null || true)}"
# HEAD travels two ways: baked into the image at build (AION_BUILD_SHA) and handed to every
# CLI run (AION_REPO_HEAD_SHA), so `doctor` can tell a stale running service from a fresh one.
AION_REPO_HEAD_SHA="$(git -C "$REPO_DIR" rev-parse --short HEAD 2>/dev/null || true)"
AION_BUILD_SHA="$AION_REPO_HEAD_SHA"
export COMPOSE_PROJECT_NAME AION_GIT_USER_NAME AION_REPO_HEAD_SHA AION_BUILD_SHA
export AION_REPO_PATH="$REPO_DIR"

# Epoch seconds of the newest tracked source file, or empty when git cannot answer.
# `git ls-files` rather than `find`, so node_modules and build output never count.
newest_source_mtime() {
  git -C "$REPO_DIR" ls-files -z -- \
      'packages/*' 'Dockerfile' 'package.json' 'package-lock.json' 'tsconfig*.json' 2>/dev/null |
    xargs -0 stat -f '%m' 2>/dev/null |
    sort -rn |
    head -1
}

image_created_epoch() {
  local created
  created="$(docker image inspect "$IMAGE" --format '{{.Created}}' 2>/dev/null)" || return 1
  # Docker reports UTC. BSD date needs the fractional seconds and the zone stripped and would
  # otherwise read the stamp as local time, putting the image hours into the future; GNU date
  # parses the whole timestamp. Try each, and treat "cannot tell" as stale rather than fresh.
  TZ=UTC date -j -f '%Y-%m-%dT%H:%M:%S' "${created%%.*}" '+%s' 2>/dev/null ||
    date -d "$created" '+%s' 2>/dev/null
}

# A `git pull` that lands new CLI or server code must not leave the user running the old
# image with no warning: the container is the only thing that ever executes this repo.
needs_build() {
  local built source
  built="$(image_created_epoch)" || return 0
  [ -n "$built" ] || return 0
  source="$(newest_source_mtime)"
  [ -n "$source" ] || return 1
  [ "$source" -gt "$built" ]
}

# A global install is `npm link` from the clone, which is a symlink chain back to this
# working tree. A copying install (`npm install -g .`) lands in global node_modules with
# no repo around it; refuse that early with the fix, instead of failing inside compose.
if [ ! -f "$COMPOSE_FILE" ]; then
  echo "aion: no compose.yaml next to this script; it is running from a copied install." >&2
  echo "aion: run \`npm link\` from the aion-local clone instead of \`npm install -g\`." >&2
  exit 1
fi

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "aion: building $IMAGE (first run)" >&2
  docker compose -f "$COMPOSE_FILE" build aion-cli
elif [ "${AION_SKIP_IMAGE_CHECK:-}" != "1" ] && needs_build; then
  echo "aion: sources are newer than $IMAGE, rebuilding" >&2
  docker compose -f "$COMPOSE_FILE" build aion-cli
fi

# The container's mounts are the repo, the docker socket, and the data volumes, so nothing
# inside it can see the harness settings. Whether hooks are installed is a host fact, computed
# here and passed through for `doctor` to check against the route reflection resolved to.
# Either harness counts: the check reads the routing, not which CLI fires the hook.
hooks_installed_in() {
  [ -f "$1" ] && grep -q 'hook-main.js' "$1"
}

if hooks_installed_in "$HOME/.claude/settings.json" ||
  hooks_installed_in "${CODEX_HOME:-$HOME/.codex}/hooks.json"; then
  AION_HOOKS_INSTALLED=true
else
  AION_HOOKS_INSTALLED=false
fi
export AION_HOOKS_INSTALLED

exec docker compose -f "$COMPOSE_FILE" run --rm aion-cli "$@"
