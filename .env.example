# Copy to .env, or let `./bin/aion init` generate it. Compose loads .env into the containers,
# and the five vars compose.yaml also names (AION_NEO4J_URI, AION_OLLAMA_URL, AION_MCP_PORT,
# AION_LOG_FILE, AION_LOG_LEVEL) are the only ones a shell can set over it. The native
# profile's launchd job is built from this file alone. On either profile the running service
# reads what is written here, not what a shell exported.
#
# What is here is what an install has to decide: where the services are, which models, the key,
# the switches that change behaviour rather than tune it, and the two sizes an operator reaches
# for on a first run. Every other knob, catalogued in the knob tables under
# packages/core/src/infrastructure/config/, is settable the same way and is left out on
# purpose. The AION_* names outside those tables are not knobs: registry.ts lists what
# `bin/aion` passes through for compose and what has been retired, and neither belongs here.
# Some knobs carry the measurement that set their value, recorded beside them in those files;
# more carry only the reasoning, and a few say outright that nothing measured them. Either way
# a value copied into .env stops following the code behind it: the pin outlives the reason for
# it, silently.

# Where the substrate runs. `docker` is the compose stack and is what every address in this
# file is written for. `native` is Neo4j and the MCP server as host processes; `aion init
# --install native` sets this and rewrites the five addresses that differ (the two below, the
# data directory, the database path and the log file) to their host values. Set it by hand to
# match a stack you brought up yourself, or on the far side of a reset: switching a native
# install back to docker means dropping both stores, setting this to `docker`, and running
# init, which is what `--install docker` refuses and prints. See docs/operations.md, "Install
# profiles".
AION_INSTALL_PROFILE=docker

# Graph. The user is always `neo4j`; compose's NEO4J_AUTH has no second account.
AION_NEO4J_URI=bolt://neo4j:7687
AION_NEO4J_PASSWORD=

# Inference. Ollama runs on the host, not in the stack, and serves the embedding model
# alone: every generation runs on the provider AION_GENERATION_PROVIDER selects below.
AION_OLLAMA_URL=http://host.docker.internal:11434

# Uncomment the two lines below only if this install's vectors were written by nomic-embed-text.
#
# The embed model owns the vector space: every stored vector and both graph vector indexes are
# sized by it, so an install cannot change models without rebuilding the graph from empty. The
# code default is snowflake-arctic-embed2 at 1024 dimensions, which is what a new install wants
# and what the docs describe. The pins below hold an older install to the model that wrote its
# vectors, and both are needed: the dimension follows the model, and a model returning 768
# floats against a 1024 index is a mismatch the doctor reports but recall does not fail on;
# both vector legs drop and BM25, entity resolution and recency carry the pack without them.
# Delete both lines when that install resets its database.
#AION_EMBED_MODEL=nomic-embed-text
#AION_EMBED_DIMENSION=768

# The one provider every generation runs on: recall cues, reflection extraction, the
# maintenance judgments and narratives. `anthropic` when unset, or `openai`. Only the selected
# provider's key is read, and `aion init full` asks for that one. Embeddings never route and
# stay on the local model.
#
# An empty key for the selected provider means no generation. Capture, embedding, the graph and
# the archive still work, recall falls back to the raw query text and says so in the pack, and
# every generation stays queued until the key is set. Nothing falls back to a local model or to
# the other provider; `aion status` prints `routing cue=queued(<provider>)
# reflect=queued(<provider>)` while that is the state. The service reads these from this file
# alone, so on a native install a key exported only in the shell does not count.
#AION_GENERATION_PROVIDER=openai
AION_ANTHROPIC_API_KEY=
AION_ANTHROPIC_MODEL=claude-haiku-4-5
AION_OPENAI_API_KEY=
#AION_OPENAI_MODEL=gpt-6-luna

# Dollars of generation one UTC day may commit, across ordinary calls and batch submissions on
# either provider together. Every dispatch holds its conservative maximum against this before it
# is sent and replaces that with what it cost when the answer lands, so what the number bounds is
# committed spend rather than reported spend, and two callers cannot each spend the whole of it.
#
# A .env written before this name existed may carry AION_ANTHROPIC_DAILY_CEILING_USD instead. That
# older name still sets the same ceiling; where both are set this one wins, and the service logs a
# warning at start if the two differ.
#
# Past it, background work queues and recall falls back to the raw query text: a spent day reads
# the same way a missing key does, because neither is something a retry can fix. `aion costs`
# prints the day against the ceiling. Five is a backstop rather than a budget; raise it for a
# substrate that does more than a day of ordinary use.
AION_DAILY_CEILING_USD=5

# How a judged contradiction is applied, and the default is set by measurement rather than by
# hand. `unanimous` sends every affirmative judgment to a second model call that argues the
# other side on the same evidence, and closes the old claim in the same run only where both
# passes agree; a vetoed judgment becomes a row for `aion proposals`. Measured 2026-08-30 on
# claude-haiku-4-5 over the 24-case battery: precision 1.000, recall 1.000, against 0.857 for
# the single pass. `propose` writes every affirmative judgment to supersession_proposals and
# closes nothing, which makes it the kill switch. `auto` is the confidence gate that came
# before both: still valid, and superseded by `unanimous`, because the judge answers 0.95 to
# every affirmative and a threshold over one value gates nothing. `aion unsupersede <id>`
# reopens any close.
AION_SUPERSEDE_MODE=unanimous

# The same shape one tier down, over identities. The dedup cascade nominates a pair, measures
# what the two share, and puts the facts to two calls: one asks whether one referent explains
# both records, the second argues that something separates them. `unanimous` merges what both
# agree on, with a decision record `aion unmerge` reads back; `propose` runs both passes and
# sends the pair to `aion proposals` instead, which makes it the kill switch. Set by the same
# kind of measurement: 2026-09-01 on claude-haiku-4-5 with snowflake-arctic-embed2, 24 pairs in
# a real graph, precision 1.000 with recall between 0.583 and 0.667 across runs, every miss a
# queued pair rather than a wrong merge. Tier 0 ignores this knob and has no switch of its
# own: it asks no model, so a mode over judgments has nothing to gate, and reflection merges
# those spellings on every episode it touches. `AION_AUTO_MERGE` governs the hourly
# whole-graph sweep of the same tier, not this one.
AION_ENTITY_MERGE_MODE=unanimous

# The subject-keyed closure path's own switch, independent of AION_SUPERSEDE_MODE: it runs
# inside a different stage's write and needs to be killable on its own. `off` is the kill
# switch and skips the keyed lookup entirely. `judge` routes a keyed candidate into the same
# two-pass unanimous supersession judge AION_SUPERSEDE_MODE uses, which closes it
# autonomously; this is the default. `close` is the mechanical keyed close, made in the
# writing transaction with no second opinion, and it acts the moment it is set. The battery
# decides only the shipped default: precision at or above 0.95 over at least four mechanical
# closes ships `close`, and the 2026-09-01 run measured 1.000 over two, a sample too small to
# ship on.
AION_KEYED_CLOSE_MODE=judge

# Whether a reading past its horizon renders as expired at read: labeled, never dropped, and
# never re-scored. Only a superseded node is down-ranked; an expired one keeps its rank and
# says the measurement is old rather than wrong. Off falls back to the read-side behavior
# from before a reading horizon existed, reporting every node as current or superseded only,
# with no stored data touched.
AION_TEMPORAL_EXPIRY_ANNOTATION=true

# The introspector's tier-3 seam. On by default: a cycle the deterministic tiers left idle
# consults the model for one recommendation, and `act` runs it through the same claim, bound and
# scoring path a deterministic selection takes. AION_MAINTENANCE_TIER3_MODE=propose is the kill
# switch inside this one: the advisor recommends and the loop runs nothing. Off skips the
# consultation entirely.
# What guards a model-chosen run is the record it leaves. Every run is scored on the metric its
# operation declared, and the acceptance floor multiplies the advisor's confidence by that score
# before anything runs, so an operation whose runs move nothing is downgraded by its own history.
# An operation nothing has scored carries a neutral 0.5 prior, which is what lets a fresh
# substrate act at all. The insight count is how many one-line lessons from recent runs ride
# into the prompt beside the numbers.
AION_MAINTENANCE_TIER3=true
AION_MAINTENANCE_TIER3_MODE=act
AION_MAINTENANCE_TIER3_ACCEPTANCE_FLOOR=0.3
AION_MAINTENANCE_TIER3_INSIGHT_COUNT=8

# Tokens a remote call that asked to reason may spend reasoning. Haiku 4.5 takes only manual
# extended thinking, so this is a budget rather than an effort word, and the API's floor is 1024.
# It is a ceiling and not a bill: the model stops under it, and the provider clamps it below each
# call's own max_tokens because thinking is billed and counted as output.
AION_ANTHROPIC_THINKING_BUDGET_TOKENS=2048

# Compression, on both of its axes. Narrative rollup compresses the day a set of sessions made
# up, and then the week those days made up, one closed window at a time. Claim consolidation
# does the same across subjects: many standing claims about one thing become the one
# higher-order claim they add up to, with every sentence citing the claims it came from. Both
# close what they absorb with an ordinary supersession, so `aion unsupersede <id>` reopens any
# member either one took, the summarization edges a rollup stamped along with it. Off leaves a
# month of work reaching recall as the separate memories that wrote it.
AION_MAINTENANCE_NARRATIVE_ROLLUP=true
AION_MAINTENANCE_CLAIM_CONSOLIDATION=true

# Joins two identities the graph left apart: a nearest-neighbour cosine brings the pair forward,
# and only a reading of the store may write the edge, so a pair carrying a cosine and nothing
# else is dropped and counted. Off leaves every under-connected identity exactly as it is.
AION_MAINTENANCE_STRUCTURAL_DISCOVERY=true

# The hourly sweep for the cascade's deterministic tier: two names that reach one key once
# separators are stripped, or an identity already answering to the other's name as an alias,
# merged over the whole graph with no model call. Off leaves those spellings standing until the
# next reflection touches one of them.
AION_AUTO_MERGE=true

# How many archived experiences `aion replay run` reads and re-derives before the next page.
# An interrupt stops the run at the next row, inside the page it is working, and the cursor
# it reports is that row's: the page decides how often progress prints, not how much an
# interrupt costs.
AION_MAINTENANCE_REPLAY_BATCH_SIZE=50

# One worker per process.
AION_WORKER_COUNT=1

# Server
AION_MCP_PORT=8765

# Storage. These two and AION_LOG_FILE below are the compose volume, and they are the one set of
# values a host run does not honour: every command but `aion init --install native` refuses them
# by name, and that init rewrites all three to addresses under the home directory.
AION_DATA_DIR=/data
AION_SQLITE_PATH=/data/aion.sqlite

# Logging
AION_LOG_FILE=/data/logs/aion.jsonl
AION_LOG_LEVEL=info

# The one operation that records a new experience unprompted: a question about an entity the
# substrate cannot describe at all, or one whose single gloss five mentions have gone past,
# taken most-mentioned first and filed as its own standing intention. Narrative rollup and
# claim consolidation only derive from what the graph already holds. Off means the substrate
# never speaks first.
AION_MAINTENANCE_CURIOSITY=true
