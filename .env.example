# Copy to .env, or let `./bin/aion init` generate it. Compose loads .env into the
# containers; every knob here is also settable in the shell. The full catalog with
# typed defaults lives in packages/core/src/infrastructure/config/.

# Graph — the user is always `neo4j`; compose's NEO4J_AUTH has no second account.
AION_NEO4J_URI=bolt://neo4j:7687
AION_NEO4J_PASSWORD=

# Inference — Ollama runs on the host, not in the stack
AION_OLLAMA_URL=http://host.docker.internal:11434
AION_OLLAMA_MODE=baremetal
AION_EMBED_MODEL=nomic-embed-text
AION_CUE_MODEL=qwen3:1.7b
AION_REFLECT_MODEL=qwen3:8b

# Empty means fully local. A key routes every generation role (recall cues, reflection
# extraction, narratives) to AION_ANTHROPIC_MODEL; embeddings stay on the local model either
# way. The two pins override one role at a time: auto follows the key, ollama forces it local,
# anthropic forces it remote.
AION_ANTHROPIC_API_KEY=
AION_ANTHROPIC_MODEL=claude-haiku-4-5
AION_CUE_PROVIDER=auto
AION_REFLECT_PROVIDER=auto

# Recall — the two values below are the code defaults, restated here because an .env that
# pins the old ones silently overrides them.
AION_CUE_BUDGET_MS=8000
AION_RECALL_MAX_EPISODES=20
AION_RECALL_TOKEN_BUDGET=1200
AION_VECTOR_ADMISSION_FLOOR=0.60
AION_CORROBORATION_FLOOR=0.55
AION_BM25_ADMISSION_MODE=exact
AION_SEARCH_WEIGHTS=0.4,0.3,0.3
AION_PACK_CLUSTER_CAP=2
AION_PACK_ENTITY_GLOSS_CAP=4
AION_FACTS_RESTATEMENT_FLOOR=0.80
AION_DECISION_INTENT_BOOST=1.25
# The ceiling on the seed budget, which scales with substrate size below it. Restated for the
# same reason as the two above: it was raised from 10, and an .env pinning the old number
# would silently cap the candidate set the fix widened.
AION_CONTEXT_RESONANCE_SEED_LIMIT=32

# Reflection — the pipeline's thresholds. Every stage cap and timeout is settable too;
# they follow AION_REFLECTION_* and the catalog lists them with their ranges.
AION_REFLECTION_ENTITY_DEDUP_THRESHOLD=0.85
AION_ASSOC_SEMANTIC_THRESHOLD=0.75
AION_REFLECTION_NARRATIVE_IDLE_MINUTES=30

# Supersession — `propose` writes every judged contradiction to supersession_proposals and
# closes nothing; `aion proposals` is where a person reviews and applies them. `auto` closes
# the old claim in the same run. The confidence gate below applies only in `auto` mode, and
# only measurement moves this: the judge emits 1.0 on near-neighbours, so 0.85 gated nothing.
AION_SUPERSEDE_MODE=propose
AION_SUPERSEDE_AUTO_CONFIDENCE=0.85
AION_REFLECTION_SUPERSEDE_FAMILY_RELATEDNESS_FLOOR=0.6

# Reflection worker — one worker, ten minutes before a dead process's claim comes back.
AION_WORKER_COUNT=1
AION_WORKER_STALE_CLAIM_TIMEOUT_MS=600000
AION_WORKER_MAX_ATTEMPTS=5

# Priority lanes — the backstop that demotes a client flooding the queue without saying so.
# Per-session first, then a global allowance so a burst of fresh sessions cannot defeat it.
AION_LANE_ARRIVAL_WINDOW_MS=300000
AION_LANE_SESSION_ARRIVAL_MAX=10
AION_LANE_GLOBAL_ARRIVAL_MAX=120
AION_LANE_HOT_SESSION_ARRIVAL_MAX=3

# Unenriched episodes `aion doctor` reports as a warning rather than a count.
AION_RECONCILE_WARN_THRESHOLD=50

# `aion doctor`'s queue-lag check: warn (never fail) past either threshold.
AION_LAG_OLDEST_UNCLAIMED_WARN_MS=600000
AION_LAG_QUEUE_DEPTH_WARN_THRESHOLD=200

# An MCP transport session with no request in this many minutes closes on its own: a
# client's close() sends no DELETE, so this is the primary trigger and not an edge case.
AION_SESSION_IDLE_EXPIRY_MINUTES=30

# Maintenance. The introspection loop observes, decides, and runs at most one operation per
# tick. An operation that keeps being passed over gains urgency with every cycle it waits;
# one whose runs stop improving anything is weighted down but never excluded.
AION_MAINTENANCE_TIER3=false
AION_MAINTENANCE_TICK_MINUTES=15
AION_MAINTENANCE_STARVATION_CYCLES=8
AION_MAINTENANCE_URGENCY_THRESHOLD=0.2
AION_MAINTENANCE_EFFECTIVENESS_FLOOR=0.5
# Substrate hygiene operations: how much each does in one run.
AION_MAINTENANCE_VECTOR_BACKFILL_BATCH_SIZE=100
AION_MAINTENANCE_CONTEXT_REFRESH_BATCH_SIZE=20
AION_MAINTENANCE_RECONCILE_BATCH_SIZE=200
AION_MAINTENANCE_DEAD_LETTER_BATCH_SIZE=50
AION_MAINTENANCE_REDACTION_PURGE_BATCH_SIZE=20
# Content operations: narrative cleanup, the retro supersession sweep, entity description
# freshness.
AION_MAINTENANCE_NARRATIVE_CLEANUP_BATCH=10
AION_MAINTENANCE_RETRO_SUPERSESSION_BATCH=5
AION_MAINTENANCE_DESCRIPTION_REFRESH_BATCH=3
AION_MAINTENANCE_DESCRIPTION_REFRESH_MENTION_GROWTH=5
# Topology operations: orphan cleanup, community detection, the symbiosis bridge. An orphan
# with no cheap relink candidate is left alone until it is this old, then forgotten. Community
# detection projects the whole content graph or none of it, so the node limit is a refusal
# rather than a truncation.
AION_MAINTENANCE_BACKBONE_REPAIR_BATCH=200
AION_MAINTENANCE_ORPHAN_CLEANUP_BATCH=200
AION_MAINTENANCE_ORPHAN_FORGET_AFTER_DAYS=30
AION_MAINTENANCE_COMMUNITY_NODE_LIMIT=20000
AION_MAINTENANCE_COMMUNITY_MIN_NODES=20
AION_MAINTENANCE_BRIDGE_MIN_COMMUNITY_SIZE=3

# Server
AION_MCP_PORT=8765

# Storage. The reinforcement queue is a rolling window: the flush drains what it can each
# run, and past the cap the oldest rows are dropped and `aion status` counts what went.
AION_SQLITE_PATH=/data/aion.sqlite
AION_REINFORCEMENT_QUEUE_CAP=50000

# Logging
AION_LOG_FILE=/data/logs/aion.jsonl
AION_LOG_LEVEL=info
