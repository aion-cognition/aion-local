# Copy to .env, or let `./bin/aion init` generate it. Compose loads .env into the
# containers; every knob here is also settable in the shell. The full catalog with
# typed defaults lives in packages/core/src/infrastructure/config/.

# Graph — the user is always `neo4j`; compose's NEO4J_AUTH has no second account.
AION_NEO4J_URI=bolt://neo4j:7687
AION_NEO4J_PASSWORD=

# Inference — Ollama runs on the host, not in the stack
AION_OLLAMA_URL=http://host.docker.internal:11434
AION_OLLAMA_MODE=baremetal
AION_EMBED_MODEL=nomic-embed-text
AION_CUE_MODEL=qwen3:1.7b
AION_REFLECT_MODEL=qwen3:8b

# Empty means fully local
AION_ANTHROPIC_API_KEY=

# Recall — the two values below are the code defaults, restated here because an .env that
# pins the old ones silently overrides them.
AION_CUE_BUDGET_MS=8000
AION_RECALL_MAX_EPISODES=20
AION_RECALL_TOKEN_BUDGET=1200
AION_MIN_RELEVANCE=0.35
AION_SEARCH_WEIGHTS=0.4,0.3,0.3

# Reflection — the pipeline's thresholds. Every stage cap and timeout is settable too;
# they follow AION_REFLECTION_* and the catalog lists them with their ranges.
AION_REFLECTION_ENTITY_DEDUP_THRESHOLD=0.85
AION_ASSOC_SEMANTIC_THRESHOLD=0.75
AION_SUPERSEDE_AUTO_CONFIDENCE=0.85
AION_REFLECTION_NARRATIVE_IDLE_MINUTES=30

# Reflection worker — one worker, ten minutes before a dead process's claim comes back.
AION_WORKER_COUNT=1
AION_WORKER_STALE_CLAIM_TIMEOUT_MS=600000
AION_WORKER_MAX_ATTEMPTS=5

# Priority lanes — the backstop that demotes a client flooding the queue without saying so.
# Per-session first, then a global allowance so a burst of fresh sessions cannot defeat it.
AION_LANE_ARRIVAL_WINDOW_MS=300000
AION_LANE_SESSION_ARRIVAL_MAX=10
AION_LANE_GLOBAL_ARRIVAL_MAX=120
AION_LANE_HOT_SESSION_ARRIVAL_MAX=3

# Unenriched episodes `aion doctor` reports as a warning rather than a count.
AION_RECONCILE_WARN_THRESHOLD=50

# Maintenance
AION_MAINTENANCE_TIER3=false

# Server
AION_MCP_PORT=8765

# Storage
AION_SQLITE_PATH=/data/aion.sqlite

# Logging
AION_LOG_FILE=/data/logs/aion.jsonl
AION_LOG_LEVEL=info
