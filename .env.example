# Copy to .env, or let `./bin/aion init` generate it. Compose loads .env into the containers;
# every knob is also settable in the shell.
#
# What is here is what an install has to decide: where the services are, which models, the key,
# and the switches that change behaviour rather than tune it. Every other AION_* var, catalogued
# in the knob tables under packages/core/src/infrastructure/config/, is settable the
# same way and is left out on purpose. Most of the rest are calibrated against measurements
# recorded beside them in those files, and a value copied into .env stops following the
# code that measured it: the pin outlives the reason for it, silently.

# Graph. The user is always `neo4j`; compose's NEO4J_AUTH has no second account.
AION_NEO4J_URI=bolt://neo4j:7687
AION_NEO4J_PASSWORD=

# Inference. Ollama runs on the host, not in the stack.
AION_OLLAMA_URL=http://host.docker.internal:11434
AION_CUE_MODEL=qwen3:1.7b
AION_REFLECT_MODEL=qwen3:8b

# Uncomment the two lines below only if this install's vectors were written by nomic-embed-text.
#
# The embed model owns the vector space: every stored vector and both graph vector indexes are
# sized by it, so an install cannot change models without rebuilding the graph from empty. The
# code default is snowflake-arctic-embed2 at 1024 dimensions, which is what a new install wants
# and what the docs describe. The pins below hold an older install to the model that wrote its
# vectors, and both are needed: the dimension follows the model, and a model returning 768
# floats against a 1024 index is a mismatch the doctor reports and recall cannot answer
# through. Delete both lines when that install resets its database.
#AION_EMBED_MODEL=nomic-embed-text
#AION_EMBED_DIMENSION=768

# Empty means fully local. A key routes every generation role (recall cues, reflection
# extraction, narratives) to AION_ANTHROPIC_MODEL; embeddings stay on the local model either
# way. The two pins override one role at a time: auto follows the key, ollama forces it local,
# anthropic forces it remote.
AION_ANTHROPIC_API_KEY=
AION_ANTHROPIC_MODEL=claude-haiku-4-5
AION_CUE_PROVIDER=auto
AION_REFLECT_PROVIDER=auto

# How a judged contradiction is applied, and the default is set by measurement rather than by
# hand. `unanimous` sends every affirmative judgment to a second model call that argues the
# other side on the same evidence, and closes the old claim in the same run only where both
# passes agree; a vetoed judgment becomes a row for `aion proposals`. Measured 2026-08-30 on
# claude-haiku-4-5 over the 24-case battery: precision 1.000, recall 1.000, against 0.857 for
# the single pass. `propose` writes every judgment to supersession_proposals and closes
# nothing, which makes it the kill switch. `auto` is the confidence gate both predate: still
# valid, and superseded by `unanimous`, because the judge answers 0.95 to every affirmative and
# a threshold over one value gates nothing. `aion unsupersede <id>` reopens any close.
AION_SUPERSEDE_MODE=unanimous

# The same shape one tier down, over identities. The dedup cascade nominates a pair, measures
# what the two share, and puts the facts to two calls: one asks whether one referent explains
# both records, the second argues that something separates them. `unanimous` merges what both
# agree on, with a decision record `aion unmerge` reads back; `propose` runs both passes and
# sends the pair to `aion proposals` instead, which makes it the kill switch. Set by the same
# kind of measurement: 2026-09-01 on claude-haiku-4-5 with snowflake-arctic-embed2, 24 pairs in
# a real graph, precision 1.000 with recall between 0.583 and 0.667 across runs, every miss a
# queued pair rather than a wrong merge. Tier 0 ignores this knob; `AION_AUTO_MERGE` is the
# switch for that one.
AION_ENTITY_MERGE_MODE=unanimous

# The subject-keyed closure path's own switch, independent of AION_SUPERSEDE_MODE: it runs
# inside a different stage's write and needs to be killable on its own. `off` is the kill
# switch and skips the keyed lookup entirely. `judge` routes a keyed candidate into the same
# two-pass unanimous supersession judge AION_SUPERSEDE_MODE uses, which closes it
# autonomously; this is the default. `close` is the mechanical keyed close, applied once its
# own battery clears the pre-registered bar the way the two modes above were measured.
AION_KEYED_CLOSE_MODE=judge

# Whether a reading past its horizon renders as expired at read: down-ranked and labeled,
# never dropped. Off falls back to the read-side behavior from before a reading horizon
# existed, reporting every node as current or superseded only, with no stored data touched.
AION_TEMPORAL_EXPIRY_ANNOTATION=true

# The introspector's tier-3 seam. On by default: a cycle the deterministic tiers left idle
# consults the model for one recommendation. AION_MAINTENANCE_TIER3_MODE=propose ships as the
# kill switch inside this one: the advisor recommends and the loop runs nothing. `act` sends
# the recommendation to a second model call that argues against it, and runs the operation only
# when both calls agree. Off skips the consultation entirely.
AION_MAINTENANCE_TIER3=true
AION_MAINTENANCE_TIER3_MODE=propose

# Compression, on both of its axes. Narrative rollup compresses the day a set of sessions made
# up, and then the week those days made up, one closed window at a time. Claim consolidation
# does the same across subjects: many standing claims about one thing become the one
# higher-order claim they add up to, with every sentence citing the claims it came from. Both
# write a supersession and nothing else, so `aion unsupersede <id>` reopens anything either one
# absorbed. Off leaves a month of work reaching recall as the separate memories that wrote it.
AION_MAINTENANCE_NARRATIVE_ROLLUP=true
AION_MAINTENANCE_CLAIM_CONSOLIDATION=true

# Joins two identities the graph left apart: a nearest-neighbour cosine brings the pair forward,
# and only a reading of the store may write the edge, so a pair carrying a cosine and nothing
# else is dropped and counted. Off leaves every under-connected identity exactly as it is.
AION_MAINTENANCE_STRUCTURAL_DISCOVERY=true

# The hourly sweep for the cascade's deterministic tier: two names that reach one key once
# separators are stripped, or an identity already answering to the other's name as an alias,
# merged over the whole graph with no model call. Off leaves those spellings standing until the
# next reflection touches one of them.
AION_AUTO_MERGE=true

# How many archived experiences `aion replay run` reads and re-derives before the next page.
# It is also the abort granularity: interrupting the run stops it between pages, so a smaller
# page loses less of the work in flight.
AION_MAINTENANCE_REPLAY_BATCH_SIZE=50

# One worker per process.
AION_WORKER_COUNT=1

# Server
AION_MCP_PORT=8765

# Storage
AION_SQLITE_PATH=/data/aion.sqlite

# Logging
AION_LOG_FILE=/data/logs/aion.jsonl
AION_LOG_LEVEL=info

# The one operation that writes new memory unprompted: a question about an entity the
# substrate keeps meeting and cannot describe, filed as its own standing intention. Off means
# the substrate never speaks first.
AION_MAINTENANCE_CURIOSITY=true
